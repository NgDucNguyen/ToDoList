{
  "name": "todolist",
  "version": "1.0.0",
  "description": "Local-first daily planner with calendars, Kanban, rich notes and an offline Vietnamese assistant",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build:web": "node scripts/prepare-web.cjs",
    "test:ui": "node scripts/check-ui.cjs",
    "test:electron": "node scripts/check-electron.cjs",
    "test:hust": "node scripts/check-hust-electron.cjs",
    "train:chatbot": "node scripts/train-chatbot.cjs",
    "prebuild-exe": "node scripts/train-chatbot.cjs",
    "build-exe": "node scripts/build-exe.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NgDucNguyen/ToDoList.git"
  },
  "engines": { "node": ">=22.12.0" },
  "keywords": ["planner", "todo", "electron", "kanban", "notes", "offline"],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/NgDucNguyen/ToDoList/issues"
  },
  "homepage": "https://github.com/NgDucNguyen/ToDoList#readme",
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-packager": "^17.1.2"
  }
}
